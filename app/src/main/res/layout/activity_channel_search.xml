<?xml version="1.0" encoding="utf-8"?>
<!--
  頻道搜尋主頁面
  結構與 activity_main.xml 完全一致，僅根 ID 改為 root_channel
  用來展示：搜尋列 → 歷史關鍵詞列 → GridView 結果
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_channel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:padding="16dp">

    <!-- 標題列 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <!-- 頻道識別徽章（僅頻道頁顯示） -->
        <TextView
            android:id="@+id/channel_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/channel_page_badge"
            android:textSize="13sp"
            android:textColor="#FFD700"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/version_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginStart="4dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/settings_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_settings"
            android:contentDescription="設定"
            android:scaleType="centerInside"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:background="@android:color/transparent"
            android:padding="4dp"
            android:layout_marginEnd="4dp" />
    </LinearLayout>

    <!-- 搜尋列 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <EditText
            android:id="@+id/search_input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/focus_search_input"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:hint="@string/channel_search_hint"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:layout_marginEnd="4dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <Button
            android:id="@+id/search_button"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/search"
            android:textSize="14sp"
            android:textColor="#000000"
            android:background="@drawable/focus_search_button"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:focusable="true"
            android:focusableInTouchMode="true" />
    </LinearLayout>

    <!-- 搜尋中狀態提示（不消耗焦點） -->
    <TextView
        android:id="@+id/searching_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#FFD700"
        android:textSize="12sp"
        android:gravity="center"
        android:visibility="gone"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:layout_marginBottom="2dp" />

    <!-- 搜尋歷史關鍵字列 -->
    <TextView
        android:id="@+id/history_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
            android:visibility="gone"
            android:focusable="false"
            android:focusableInTouchMode="false" />

    <HorizontalScrollView
        android:id="@+id/history_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/history_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp" />

    </HorizontalScrollView>

    <!-- 結果區域 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <GridView
            android:id="@+id/results_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:numColumns="auto_fit"
            android:columnWidth="200dp"
            android:verticalSpacing="12dp"
            android:horizontalSpacing="16dp"
            android:stretchMode="columnWidth"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:descendantFocusability="afterDescendants" />

        <!-- 無搜索結果提示 -->
        <TextView
            android:id="@+id/empty_state_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|left"
            android:layout_margin="16dp"
            android:text=""
            android:textColor="#FFD700"
            android:textSize="16sp"
            android:gravity="start"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
