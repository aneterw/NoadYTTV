<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:padding="16dp">

    <!-- 標題與設定按鈕（標題左，設定右） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="8dp">

        <!-- 標題 -->
        <TextView
            android:id="@+id/app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/version_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginStart="4dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 設定按鈕（右上角，圖示風格，背景透明融入表頭） -->
        <ImageView
            android:id="@+id/settings_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_settings"
            android:contentDescription="設定"
            android:scaleType="centerInside"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:background="@android:color/transparent"
            android:padding="4dp"
            android:layout_marginEnd="4dp" />
    </LinearLayout>

    <!-- 搜尋列（搜尋框 + 搜尋按鈕並排，縮小） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <!-- 搜尋輸入框 -->
        <EditText
            android:id="@+id/search_input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/focus_search_input"
            android:textColor="#FFFFFF"
            android:textColorHint="#999999"
            android:hint="@string/search_hint"
            android:textSize="15sp"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:gravity="center"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <!-- 搜尋按鈕 -->
        <Button
            android:id="@+id/search_button"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:background="@drawable/focus_search_button"
            android:text="@string/search"
            android:textColor="#000000"
            android:textSize="13sp"
            android:textStyle="bold"
            android:focusable="true"
            android:focusableInTouchMode="true" />

    </LinearLayout>

    <!-- 搜尋中狀態 -->
    <TextView
        android:id="@+id/searching_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#FFD700"
        android:textSize="12sp"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginBottom="2dp" />

    <!-- 搜尋歷史關鍵字（橫向滾動，無標題） -->
    <HorizontalScrollView
        android:id="@+id/history_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:scrollbars="none"
        android:layout_marginBottom="2dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/history_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp" />

    </HorizontalScrollView>

    <!-- 結果區域（方格顯示） -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <GridView
            android:id="@+id/results_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:numColumns="auto_fit"
            android:columnWidth="200dp"
            android:verticalSpacing="12dp"
            android:horizontalSpacing="16dp"
            android:stretchMode="columnWidth"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <!-- 無搜索結果提示（顯示在結果區域左上角） -->
        <TextView
            android:id="@+id/empty_state_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|left"
            android:layout_margin="16dp"
            android:text=""
            android:textColor="#FFD700"
            android:textSize="16sp"
            android:gravity="start"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>